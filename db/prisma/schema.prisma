generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BusinessStatus {
  pending
  trial
  active
  past_due
  suspended
}

enum PlanTier {
  trial
  starter
  growth
  enterprise
}

enum TeamRole {
  owner
  manager
  employee
}

enum InviteStatus {
  pending
  active
  disabled
}

enum CampaignType {
  stamps
  spend
  visits
  birthday
  cashback
  promo
}

/// How often a customer may Resgatar a Promoção. Null on the Campanha means unlimited.
enum PromoRedeemPeriod {
  day
  week
  month
  year
  campaign
}

enum CampaignStatus {
  draft
  active
  paused
  archived
}

enum TransactionType {
  stamp
  redeem
}

enum WhatsAppConnectionStatus {
  connected
  disconnected
  error
}

/// Meta message template review state for the earn summary template.
enum WhatsAppTemplateStatus {
  missing
  pending
  approved
  rejected
  paused
  disabled
}

// ─── Platform ────────────────────────────────────────────────────────────────

/// Operadores Frego (aprovam novos estabelecimentos).
model PlatformAdmin {
  id          String   @id @default(cuid())
  email       String   @unique
  firebaseUid String   @unique @map("firebase_uid")
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

model Plan {
  id          String   @id @default(cuid())
  tier        PlanTier @unique
  name        String
  mrrCents    Int      @default(0) @map("mrr_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  billingAccounts BillingAccount[]

  @@map("plans")
}

model BillingAccount {
  id         String         @id @default(cuid())
  businessId String         @unique @map("business_id")
  planId     String         @map("plan_id")
  status     BusinessStatus @default(trial)
  mrrCents   Int            @default(0) @map("mrr_cents")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])

  @@map("billing_accounts")
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Business {
  id        String         @id @default(cuid())
  name      String
  /// padaria | café | restaurant | pizzaria | hamburgueria | … (see @frego/tokens BUSINESS_TYPES)
  type      String
  status    BusinessStatus @default(trial)
  logoUrl   String?        @map("logo_url")
  /// Imagem de capa (hero) da página pública e detalhe no app.
  heroImageUrl String?       @map("hero_image_url")
  /// Cor da loja nas superfícies dela (página pública, cartão no app). Não pinta o cromado da Frego.
  primaryColor   String  @default("#070707") @map("primary_color")
  primaryColorDark String @default("#070707") @map("primary_color_dark")
  slogan         String? @map("slogan")
  /// CNPJ, apenas dígitos. Opcional no cadastro.
  cnpj           String? @unique
  /// Página / slug público (ex. bloom-coffee)
  slug           String? @unique
  /// Quantos reais o cliente precisa gastar para ganhar 1 ponto no acúmulo.
  pointsPerReal  Int     @default(1) @map("points_per_real")
  /// Legado — a % agora vive em cada campanha de cashback.
  cashbackPercent Int    @default(0) @map("cashback_percent")
  /// Teto opcional de cashback por compra, em centavos.
  cashbackMaxCents Int?  @map("cashback_max_cents")
  /// Compra mínima (centavos pagos) para creditar cashback.
  cashbackMinPurchaseCents Int? @map("cashback_min_purchase_cents")
  /// Dias até carimbos expirarem após o ganho. null = não expiram.
  stampsExpireDays Int?  @map("stamps_expire_days")
  /// Dias até pontos expirarem após o ganho. null = não expiram.
  pointsExpireDays Int?  @map("points_expire_days")
  /// Dias até o cashback expirar após o ganho. null = não expira.
  cashbackExpireDays Int? @map("cashback_expire_days")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  locations    Location[]
  teamMembers  TeamMember[]
  memberships  Membership[]
  campaigns    Campaign[]
  audienceSegments AudienceSegment[]
  tags         BusinessTag[]
  transactions Transaction[]
  billing      BillingAccount?
  whatsapp     BusinessWhatsAppConnection?
  whatsappWebhookEvents WhatsAppWebhookEvent[]

  @@map("businesses")
}

model Location {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  address    String?
  isOpen     Boolean  @default(true) @map("is_open")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  teamMembers        TeamMember[]
  campaignLocations  CampaignLocation[]
  transactions       Transaction[]

  @@index([businessId])
  @@map("locations")
}

model TeamMember {
  id          String       @id @default(cuid())
  businessId  String       @map("business_id")
  locationId  String?      @map("location_id")
  firebaseUid String       @map("firebase_uid")
  /// Login do staff: e-mail (Firebase Email/Password)
  email       String?      @map("email")
  /// Opcional — staff não usa telefone como conta
  phoneE164   String?      @map("phone_e164")
  displayName String?      @map("display_name")
  role        TeamRole     @default(employee)
  status      InviteStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  taggedMemberships MembershipTag[]

  @@unique([businessId, firebaseUid])
  @@index([firebaseUid])
  @@index([email])
  @@index([phoneE164])
  @@map("team_members")
}

// ─── Global customer identity ────────────────────────────────────────────────

/// Platform-level person. Phone is the account. Never scoped to a business.
model Customer {
  id          String    @id @default(cuid())
  phoneE164   String    @unique @map("phone_e164")
  /// Últimos 4 dígitos — busca rápida no balcão (escopo do tenant na API)
  phoneLast4  String?   @map("phone_last4")
  displayName String?   @map("display_name")
  birthday    DateTime? @db.Date
  firebaseUid String?   @unique @map("firebase_uid")
  /// true depois que o cliente conclui o fluxo de perfil no app.
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  /// Opt-out de push no app. Default on — OS permission is still required.
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  /// Set when the customer deletes the in-app account (PII anonymized).
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships  Membership[]
  deviceTokens DeviceToken[]
  transactions Transaction[] @relation("CustomerActorTransactions")

  @@index([phoneLast4])
  @@index([deletedAt])
  @@map("customers")
}

/// FCM registration token for the customer app. One current token per platform.
model DeviceToken {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  token      String   @unique
  /// ios | android
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, platform])
  @@index([customerId])
  @@map("device_tokens")
}

/// Customer × business association. Stamps/transactions live here, not on Customer.
model Membership {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  businessId   String   @map("business_id")
  isVip        Boolean  @default(false) @map("is_vip")
  /// Cliente marcou a loja como favorita no app.
  isFavorite   Boolean  @default(false) @map("is_favorite")
  associatedAt DateTime @default(now()) @map("associated_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  tags         MembershipTag[]

  @@unique([customerId, businessId])
  @@index([businessId])
  @@index([customerId, isFavorite])
  @@map("memberships")
}

/// House-defined label. Catalog lives on the business; assignment is per membership.
model BusinessTag {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  name       String
  color      String?
  sortOrder  Int       @default(0) @map("sort_order")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships MembershipTag[]

  @@index([businessId])
  @@map("business_tags")
}

model MembershipTag {
  membershipId         String   @map("membership_id")
  tagId                String   @map("tag_id")
  taggedAt             DateTime @default(now()) @map("tagged_at")
  taggedByTeamMemberId String?  @map("tagged_by_team_member_id")

  membership         Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tag                BusinessTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taggedByTeamMember TeamMember? @relation(fields: [taggedByTeamMemberId], references: [id], onDelete: SetNull)

  @@id([membershipId, tagId])
  @@index([tagId])
  @@index([taggedByTeamMemberId])
  @@map("membership_tags")
}

// ─── Campaigns & rewards ─────────────────────────────────────────────────────

model Campaign {
  id           String         @id @default(cuid())
  businessId   String         @map("business_id")
  name         String
  type         CampaignType   @default(stamps)
  status       CampaignStatus @default(draft)
  /// Meta para recompensa: carimbos necessários OU pontos necessários (spend).
  stampsNeeded Int?           @map("stamps_needed")
  /// Spend: reais gastos para ganhar 1 ponto (ex. 10 = R$10 → 1 pt).
  pointsPerReal Int?          @map("points_per_real")
  /// Cashback: % do valor pago creditado em R$ (0–100). Só type cashback.
  cashbackPercent Int?        @map("cashback_percent")
  /// Promoção: first calendar day (America/Sao_Paulo), inclusive.
  startsOn     DateTime?      @map("starts_on") @db.Date
  /// Promoção: last calendar day (America/Sao_Paulo), inclusive.
  endsOn       DateTime?      @map("ends_on") @db.Date
  /// Promoção: 0=Sun … 6=Sat in America/Sao_Paulo. Empty = all days.
  weekdays     Int[]          @default([]) @map("weekdays")
  /// Promoção: max Resgates in the period. Null = unlimited.
  redeemMax    Int?           @map("redeem_max")
  redeemPeriod PromoRedeemPeriod? @map("redeem_period")
  rewardTitle  String?        @map("reward_title")
  rewardDescription String?   @map("reward_description")
  /// Foto do prêmio (produto) — aparece no app e no balcão.
  rewardImageUrl String?      @map("reward_image_url")
  /// Stamp Campanha only. Carimbos earned here Resgatar only this Prêmio.
  /// Chosen before the first activation, then fixed.
  cartela      Boolean   @default(false)
  /// Set the first time the Campanha becomes active. Locks cartela.
  activatedAt  DateTime? @map("activated_at")
  /// Se definido, só membros da audiência podem resgatar.
  audienceSegmentId String?   @map("audience_segment_id")
  /// Set when audience FCM was claimed/sent. Re-activate does not send again.
  audiencePushSentAt DateTime? @map("audience_push_sent_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audienceSegment AudienceSegment? @relation(fields: [audienceSegmentId], references: [id], onDelete: SetNull)
  locations   CampaignLocation[]
  transactions Transaction[]

  @@index([businessId, status])
  @@index([audienceSegmentId])
  @@map("campaigns")
}

/// Audiência salva: regras JSON para segmentar clientes (gasto, inatividade, etc.).
model AudienceSegment {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  /// AudienceRules v1 — ver services/api/src/lib/audience.ts
  rules      Json
  /// Mostrar selo de reconhecimento no app do cliente quando elegível.
  showBadge    Boolean @default(false) @map("show_badge")
  /// Título do selo no app (ex. "Cliente da casa").
  badgeTitle   String? @map("badge_title")
  /// Mensagem curta (ex. "Você desbloqueou promoções exclusivas.").
  badgeMessage String? @map("badge_message")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([businessId])
  @@map("audience_segments")
}

model CampaignLocation {
  campaignId String @map("campaign_id")
  locationId String @map("location_id")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([campaignId, locationId])
  @@map("campaign_locations")
}

// ─── Immutable ledger ────────────────────────────────────────────────────────

/// Append-only. Balances/progress are ALWAYS derived from this table.
model Transaction {
  id                String          @id @default(cuid())
  businessId        String          @map("business_id")
  membershipId      String          @map("membership_id")
  campaignId        String?         @map("campaign_id")
  locationId        String          @map("location_id")
  /// Staff no acúmulo; null quando o cliente resgata no app.
  actorTeamMemberId String?         @map("actor_team_member_id")
  /// Cliente no resgate pelo app.
  actorCustomerId   String?         @map("actor_customer_id")
  type              TransactionType
  /// Carimbos ganhos, pontos ganhos, ou quantidade de resgates.
  quantity          Int             @default(1)
  /// Earn: 'stamps' | 'points' | 'cashback_cents'. Null em txs legadas.
  unitKind          String?         @map("unit_kind")
  /// Spend: valor cobrado em centavos (R$ 12,50 → 1250).
  amountCents       Int?            @map("amount_cents")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")

  business        Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership      Membership  @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  campaign        Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actorTeamMember TeamMember? @relation(fields: [actorTeamMemberId], references: [id], onDelete: Restrict)
  actorCustomer   Customer?   @relation("CustomerActorTransactions", fields: [actorCustomerId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([membershipId, campaignId, type])
  @@index([membershipId, type, unitKind])
  @@index([locationId, createdAt])
  @@map("transactions")
}

// ─── WhatsApp (per-business Cloud API) ───────────────────────────────────────

/// One official WABA phone per business — never a shared platform number.
model BusinessWhatsAppConnection {
  id                 String                   @id @default(cuid())
  businessId         String                   @unique @map("business_id")
  metaBusinessId     String?                  @map("meta_business_id")
  wabaId             String                   @map("waba_id")
  phoneNumberId      String                   @unique @map("phone_number_id")
  displayPhoneNumber String?                  @map("display_phone_number")
  verifiedName       String?                  @map("verified_name")
  qualityRating      String?                  @map("quality_rating")
  messagingLimitTier String?                 @map("messaging_limit_tier")
  /// AES-GCM ciphertext of the access token (base64).
  tokenCiphertext    String                   @map("token_ciphertext")
  tokenKeyVersion    Int                      @default(1) @map("token_key_version")
  templateEarnName   String                   @default("frego_earn_summary") @map("template_earn_name")
  templateEarnLang   String                   @default("pt_BR") @map("template_earn_lang")
  templateEarnStatus WhatsAppTemplateStatus   @default(missing) @map("template_earn_status")
  templateEarnId     String?                  @map("template_earn_id")
  templateEarnSyncedAt DateTime?              @map("template_earn_synced_at")
  /// Welcome when the store registers a customer phone.
  templateWelcomeName   String                   @default("frego_welcome") @map("template_welcome_name")
  templateWelcomeLang   String                   @default("pt_BR") @map("template_welcome_lang")
  templateWelcomeStatus WhatsAppTemplateStatus   @default(missing) @map("template_welcome_status")
  templateWelcomeId     String?                  @map("template_welcome_id")
  templateWelcomeSyncedAt DateTime?              @map("template_welcome_synced_at")
  /// Audience campaign announcement (same copy as push).
  templateCampaignName   String                   @default("frego_campaign_notice") @map("template_campaign_name")
  templateCampaignLang   String                   @default("pt_BR") @map("template_campaign_lang")
  templateCampaignStatus WhatsAppTemplateStatus   @default(missing) @map("template_campaign_status")
  templateCampaignId     String?                  @map("template_campaign_id")
  templateCampaignSyncedAt DateTime?              @map("template_campaign_synced_at")
  /// True when onboarded via WhatsApp Business app coexistence (keep app + Cloud API).
  coexistence        Boolean                  @default(false)
  smbSyncStartedAt   DateTime?                @map("smb_sync_started_at")
  smbContactsSyncRequestId String?            @map("smb_contacts_sync_request_id")
  smbHistorySyncRequestId  String?            @map("smb_history_sync_request_id")
  status             WhatsAppConnectionStatus @default(connected)
  webhookSubscribedAt DateTime?               @map("webhook_subscribed_at")
  connectedAt        DateTime                 @default(now()) @map("connected_at")
  lastError          String?                  @map("last_error")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([wabaId])
  @@map("business_whatsapp_connections")
}

/// Idempotent ingest of Meta webhook deliveries / template updates.
model WhatsAppWebhookEvent {
  id           String   @id @default(cuid())
  businessId   String?  @map("business_id")
  eventKey     String   @unique @map("event_key")
  phoneNumberId String? @map("phone_number_id")
  eventType    String   @map("event_type")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([phoneNumberId])
  @@map("whatsapp_webhook_events")
}
